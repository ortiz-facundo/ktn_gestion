# ktn_gestion — .env.local template for cPanel + FTP deploys
#
# INSTRUCTIONS
# ============
# 1. Copy this file to `.env.local` (in the same directory).
# 2. Replace every `CHANGE_ME_*` with the real value.
# 3. Generate APP_SECRET with: php -r "echo bin2hex(random_bytes(32));"
#    Or: openssl rand -hex 32
# 4. Generate DEPLOY_KEY with: openssl rand -hex 16
#    (must match the ?key= query string you pass to deploy.php)
# 5. Set file mode 0600 once on the server:
#       chmod 600 .env.local
#
# This file MUST NOT be committed to git (the project's .gitignore already
# excludes every .env.*.local). After the first deploy succeeds, delete
# the DEPLOY_KEY line entirely — deploy.php self-deletes and the key
# has no further use.

# --- Runtime ----------------------------------------------------------------

APP_ENV=prod
APP_DEBUG=0

# 64 hex chars. Critical: used to sign CSRF tokens and session cookies.
# Regenerate this on every fresh install.
APP_SECRET=PASTE_RANDOM_HEX_HERE

# Symfony's runtime auto-detects project_dir from vendor/'s location, so we
# don't strictly need this — but setting it makes the boot robust if anyone
# ever moves vendor/ or the doc root. The path here is the subdomain's
# document root. cPanel typically creates
# /home/<user>/CHANGE_ME_DOMAIN/ for the subdomain; if yours
# lives under public_html/ instead (see README_DEPLOY.md §"Domain root
# gotcha"), adjust accordingly.
APP_PROJECT_DIR=/home/CPANEL_USER/CHANGE_ME_DOMAIN

# --- Routing ---------------------------------------------------------------

DEFAULT_URI=https://CHANGE_ME_DOMAIN

# --- Database (cPanel MySQL/MariaDB) ---------------------------------------
#
# HOST is almost always `localhost` on cPanel shared hosting (not
# 127.0.0.1). The serverVersion must match what phpMyAdmin reports under
# "Server version" — typically 10.11.x-MariaDB-cll-lve-log on cPanel.
# To verify: open phpMyAdmin, the version is on the right-hand panel.
DATABASE_URL="mysql://CPANEL_DB_USER:CPANEL_DB_PASSWORD@localhost:3306/CPANEL_DB_NAME?serverVersion=10.11.18-MariaDB-cll-lve-log&charset=utf8mb4"

# --- Mailer ----------------------------------------------------------------
#
# SMTP is the only transport that works on cPanel-class shared hosts
# because sendmail://default relies on PHP's proc_open() to spawn the
# local sendmail binary — and cPanel disables proc_open in
# disable_functions for security. We use `?verify_peer=0` to bypass
# the cert CN mismatch (the local Exim cert has CN
# `cpanelNNN.wnpservers.net`, not `localhost`).
#
# The username is the full email address; the password is the
# cPanel email-account password (NOT the cPanel account password).
# Create the mailbox in cPanel → Email → Email Accounts first.
#
# Standard form:
#   smtps://noreply@CHANGE_ME_DOMAIN:PASSWORD@localhost:465?verify_peer=0
# Or port 587 with STARTTLS (if your host only exposes 587):
#   smtps://noreply@CHANGE_ME_DOMAIN:PASSWORD@localhost:587?verify_peer=0
MAILER_DSN="smtps://CPANEL_EMAIL_USER:CPANEL_EMAIL_PASSWORD@localhost:465?verify_peer=0"
MAILER_FROM=noreply@CHANGE_ME_DOMAIN
MAILER_FROM_NAME="CHANGE_ME_APP_NAME"

# Public base URL — used in confirmation emails (admin account
# confirmation links).
APP_URL=https://CHANGE_ME_DOMAIN

# --- One-shot installer (delete after first deploy) -----------------------
#
# Long random string. Must match the `?key=` query parameter when calling
# https://CHANGE_ME_DOMAIN/deploy.php?key=<this-value>. After
# the installer succeeds it self-deletes — this line should then be
# removed.
DEPLOY_KEY=PASTE_RANDOM_HEX_HERE

# --- Initial backoffice admin user (used by deploy.php on first run) -----
#
# Set these to create the first backoffice admin via the deploy
# installer. The admin is created in USER_STATE_PENDING and a
# confirmation link is emailed. The admin clicks the link, picks a
# password, and is auto-activated. Then they can log in at /login and
# land on /dashboard.
#
# Leave PROD_ADMIN_EMAIL empty to skip seeding an admin user — useful if
# you plan to create accounts manually later (e.g. via phpMyAdmin).
PROD_ADMIN_EMAIL=admin@CHANGE_ME_DOMAIN
PROD_ADMIN_NAME="Site Administrator"

# --- Notifications (Chrome desktop / Android Web Push) -------------------
# Generate once locally with app:notifications:vapid-keys. Keep these values
# stable across deployments; never commit the private key.
NOTIFICATION_PUSH_ENABLED=0
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=
NOTIFICATION_VAPID_SUBJECT=mailto:noreply@CHANGE_ME_DOMAIN
