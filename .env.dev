###> symfony/framework-bundle ###
# APP_SECRET is intentionally NOT set here.
# The real secret lives in untracked .env.local (and .env.local.php for prod).
# Leave this file free of secrets so it stays safe to commit.
###< symfony/framework-bundle ###

###> symfony/mailer ###
# Dev defaults to Mailpit (the docker compose override). Symfony sends
# to mailer:1025 (docker network DNS); the web UI is at
# http://localhost:8075. No email leaves the dev machine, and the team
# can see every captured email in the web UI.
#
# Override per-developer in .env.local with a real SMTP (Mailgun, SES,
# Mailtrap, etc.) only if you need to test the actual delivery path.
# Format: smtp://USER:PASS@HOST:PORT  (or smtps:// for implicit TLS).
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=no-reply@ketten.local
MAILER_FROM_NAME="Ketten"
# Public URL used when building absolute links in emails (the
# /account/confirm link in particular).
APP_URL=http://localhost:8070
###< symfony/mailer ###
