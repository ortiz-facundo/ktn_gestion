{#
    Sidebar nav. This file is the single place to edit when adding or
    re-ordering sidebar items: just append a row to the `nav_groups_declared`
    set below. The renderer (macros + Heroicons map) lives in
    `_nav_macros.html.twig`; the outer chrome (logo, footer chip, sign-
    out) is at the bottom of this file.

    Item schema:
      {
        label:        string,                              link text
        route:        string,                              Symfony route name (for path())
        route_prefix: string,                              prefix used for active-state matching
                                                          via `current_route starts with route_prefix`.
                                                          MUST be the Symfony route-name prefix
                                                          (e.g. 'administration_user'), NOT the
                                                          URL-path prefix (e.g. '/admin/users').
                                                          Per project convention, route names use
                                                          the full module word even when URL paths
                                                          use a shorter prefix.
        permission:   string|null,                         App\Security\Permission::* constant
                                                          name WITHOUT the class prefix (e.g.
                                                          'PERMISSION_MANAGE_USERS'). null =
                                                          visible to anyone signed in.
        icon:         string,                              key into the icon map in
                                                          _nav_macros.html.twig. Current keys:
                                                          'dashboard', 'users', 'shield', 'key'.
      }

    Group schema:
      position: 'first'|'last'|null (optional)             render-order anchor.
                                                          'first'  → always rendered first
                                                                    (declared order if multiple).
                                                          'last'   → always rendered last
                                                                    (declared order if multiple).
                                                          null/absent → standalone, rendered
                                                                    in declared order between
                                                                    the first and last tiers.
      label: string|null                                  group heading. null = un-grouped
                                                          (no <h2>, no rule). Used for Dashboard.

    Render order is driven by `position`: first-tier → standalone-tier →
    last-tier. Within each tier the declared order is preserved. This lets
    downstream projects append new modules as standalone (no `position`)
    and have them slot between the skeleton's pinned Dashboard and
    Administration groups automatically — without re-ordering the
    declared array.

    Graceful collapse: groups with no items the current user is granted
    render nothing (no heading, no rule). See _nav_macros.html.twig.

    Each item is permission-gated. Groups with no visible items are
    dropped entirely. Active item is highlighted and receives
    `aria-current="page"`.

    Contract:
      @var current_route  string  the active route name (for highlighting)
#}
{% set nav_groups_declared = [
    {
        position: 'first',
        label: null,
        items: [
            {
                label: 'app.backoffice.nav.dashboard'|trans,
                route: 'backoffice_dashboard',
                route_prefix: 'backoffice_dashboard',
                permission: 'PERMISSION_VIEW_BACKOFFICE',
                icon: 'dashboard',
            },
        ],
    },
    {
        position: 'last',
        label: 'app.backoffice.nav.administration'|trans,
        items: [
            {
                label: 'app.backoffice.nav.users'|trans,
                route: 'administration_user_list',
                route_prefix: 'administration_user',
                permission: 'PERMISSION_MANAGE_USERS',
                icon: 'users',
            },
            {
                label: 'app.backoffice.nav.roles'|trans,
                route: 'administration_role_list',
                route_prefix: 'administration_role',
                permission: 'PERMISSION_MANAGE_ROLES',
                icon: 'shield',
            },
            {
                label: 'app.backoffice.nav.permissions'|trans,
                route: 'administration_permission_list',
                route_prefix: 'administration_permission',
                permission: 'PERMISSION_MANAGE_PERMISSIONS',
                icon: 'key',
            },
        ],
    },
] %}

{# Position-driven sort. Splits the declared array into three tiers and
   concatenates them in canonical order: first → standalone → last.
   Within each tier, declared order is preserved. #}
{% set first_groups = [] %}
{% set standalone_groups = [] %}
{% set last_groups = [] %}
{% for group in nav_groups_declared %}
    {% if group.position|default(null) == 'first' %}
        {% set first_groups = first_groups|merge([group]) %}
    {% elseif group.position|default(null) == 'last' %}
        {% set last_groups = last_groups|merge([group]) %}
    {% else %}
        {% set standalone_groups = standalone_groups|merge([group]) %}
    {% endif %}
{% endfor %}
{% set nav_groups = first_groups|merge(standalone_groups)|merge(last_groups) %}
{% import 'backoffice/_nav_macros.html.twig' as nav %}

{# Off-canvas on mobile, sticky static at `lg`+. Below `lg` the
   `<aside>` is `fixed inset-y-0 left-0` and translated -100% on X,
   so it sits off-screen until `assets/js/sidebar-toggle.js` opens
   it (the matching data-* contract is documented there). At `lg`
   and up Tailwind's responsive utilities pin it back into the
   normal flow (`lg:sticky lg:top-0 lg:translate-x-0`). #}
<aside data-sidebar
       class="fixed inset-y-0 left-0 z-40 flex h-screen w-64 -translate-x-full flex-col border-r border-stone-200 bg-white transition-transform duration-200 ease-in-out lg:sticky lg:top-0 lg:z-30 lg:translate-x-0">
    <div class="flex h-16 items-center justify-between gap-2 border-b border-stone-200 px-6">
        <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-xl">🛠</span>
            <span class="font-serif text-lg text-stone-900">KTN Gestión</span>
        </div>
        <button type="button" data-sidebar-close
                aria-label="{{ 'app.backoffice.nav.close_menu'|trans }}"
                title="{{ 'app.backoffice.nav.close_menu'|trans }}"
                class="lg:hidden inline-flex h-9 w-9 items-center justify-center rounded-md text-stone-500 hover:bg-stone-100 hover:text-stone-900 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 py-6" aria-label="Main">
        <div class="space-y-6">
            {% for group in nav_groups %}
                {{ nav.nav_group(group, current_route) }}
            {% endfor %}
        </div>
    </nav>

    <div class="border-t border-stone-200 px-3 py-4">
        {# Profile chip + notification bell. The chip is the primary
           affordance (opens /account/profile-settings) and takes the
           leftover width; the bell is docked to its right and its panel
           flies out beside the sidebar. Below `lg` the sidebar is a
           drawer, so the bell lives in the mobile top bar instead (see
           backoffice/base.html.twig). #}
        <div class="flex items-center gap-1">
            <a href="{{ path('account_profile_settings') }}"
               class="flex min-w-0 flex-1 items-center gap-3 rounded-md px-2 py-2 hover:bg-stone-100">
                {% include '_avatar.html.twig' with {user: app.user, size: 'sm'} only %}
                <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm font-medium text-stone-900">
                        {{ app.user.name ?: app.user.email }}
                    </span>
                    <span class="block truncate text-xs text-stone-500">{{ app.user.email }}</span>
                </span>
            </a>
            <div class="hidden lg:block">
                {% include 'notification/_bell.html.twig' with {placement: 'sidebar'} only %}
            </div>
        </div>

        {# Sign out: separate small button so the chip above can stay focused
           on "go to your profile". Indent aligns under the name/email column.
           security_logout accepts POST + CSRF token ('logout' token id). #}
        <form method="post" action="{{ path('security_logout') }}" class="mt-1">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit"
                    class="flex w-full items-center gap-2 rounded-md px-2 py-2 pl-[3.25rem] text-left text-xs font-medium text-stone-500 hover:bg-stone-100 hover:text-stone-900">
                <span>{{ 'app.backoffice.sign_out'|trans }}</span>
            </button>
        </form>
    </div>
</aside>
